---
import Icon from "@components/building-blocks/core-elements/icon/Icon.astro";
import List from "@components/building-blocks/core-elements/list/List.astro";
import Text from "@components/building-blocks/core-elements/text/Text.astro";
import Card from "@components/building-blocks/wrappers/card/Card.astro";
import Split from "@components/building-blocks/wrappers/split/Split.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection, type CollectionEntry } from "astro:content";

// Automatically import all components from building-blocks and page-sections for MDX
const buildingBlocksImports = import.meta.glob("../../components/building-blocks/**/*.astro", {
  eager: true,
});

const pageSectionsImports = import.meta.glob("../../components/page-sections/**/*.astro", {
  eager: true,
});

// Merge both import objects
const componentImports = { ...buildingBlocksImports, ...pageSectionsImports };

// Build components object with PascalCase names from file paths
const mdxComponents: Record<string, any> = {};

Object.entries(componentImports).forEach(([path, module]) => {
  const pathParts = path.split("/");
  const fileName = pathParts[pathParts.length - 1].replace(".astro", "");

  // Component name is already PascalCase from filename
  const componentName = fileName;

  mdxComponents[componentName] = (module as any).default;
});

export async function getStaticPaths() {
  const posts = await getCollection("recipes");

  return posts.map((post: CollectionEntry<"recipes">) => {
    const slug = post.id?.replace(/\.md?$/, "") || post.slug;

    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<"recipes">;
}

const { post } = Astro.props;

const ingredients = post.data.method?.flatMap((step) =>
  step.ingredients.map((ing: any) => ({
    text: `${ing.quantity}${ing.measurement} ${ing.ingredient}`,
  }))
);

const totalTime = (post?.data.prepTime || 0) + (post?.data.cookTime || 0);
const hours = Math.floor(totalTime / 60);
const minutes = totalTime % 60;

const parsedTime =
  totalTime > 0 ? `${hours ? `${hours}h ` : ""}${minutes ? `${minutes}m` : ""}`.trim() : "N/A";
---

<Page
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.source}
>
  <CustomSection
    maxContentWidth="xl"
    paddingHorizontal="lg"
    paddingVertical="4xl"
    colorScheme="inherit"
    backgroundColor="base"
    class="post-container"
    useDefaultEditableBinding={false}
  >
    <Split
      distributionMode="half"
      minSplitWidth="700"
      gap="xl"
      class="ingredients"
      useDefaultEditableBinding={false}
    >
      <Fragment slot="first">
        <Heading
          data-prop="title"
          level="h1"
          size="2xl"
          style="margin-bottom: var(--spacing-xs);"
        >
          {post.data.title}
        </Heading>

        {
          post.data.description && (
            <SimpleText
              data-prop="description"
              size="lg"
              style="color: var(--color-text-muted); margin-bottom: 0; margin-top: var(--spacing-xs);"
            >
              {post.data.description}
            </SimpleText>
          )
        }

        {
          totalTime > 0 && (
            <div class="time">
              <Icon
                name="clock"
                size="sm"
                aria-hidden="true"
                role="presentation"
                useDefaultEditableBinding={false}
              />
              <Text
                style="margin-top: 0;"
                useDefaultEditableBinding={false}
              >
                {parsedTime}
              </Text>
            </div>
          )
        }

        <Card
          style="sticky"
          backgroundColor="highlight"
          paddingHorizontal="md"
          paddingVertical="md"
          useDefaultEditableBinding={false}
        >
          <Fragment>
            <Heading
              level="h2"
              size="sm"
              useDefaultEditableBinding={false}
            >
              Ingredients
            </Heading>
            <List
              useDefaultEditableBinding={false}
              items={ingredients || []}
              listType="bullet"
              style="margin-top: var(--spacing-sm);"
            />
          </Fragment>
        </Card>

        <div class="cooking_mode">
          <input
            type="checkbox"
            id="cooking_mode"
            name="cooking_mode"
          />
          <label for="cooking_mode">Enable Cooking Mode</label>
        </div>
      </Fragment>

      <Fragment slot="second">
        {
          post.data.image && (
            <Image
              data-prop-src="image.source"
              data-prop-alt="image.alt"
              source={post.data.image.source}
              alt={post.data.title}
              rounded={true}
              class="post-image"
              aspectRatio="square"
              positionVertical="center"
            />
          )
        }
      </Fragment>
    </Split>

    <div class="recipe">
      <Heading
        useDefaultEditableBinding={false}
        level="h2"
        size="xl"
        style="margin-top: var(--spacing-2xl);"
      >
        Method
      </Heading>
      <ol
        data-editable="array"
        data-prop="method"
        data-component-key="building-blocks/core-elements/list/list-item"
      >
        {
          post.data.method &&
            post.data.method.map((step: any, index: number) => (
              <li
                data-editable="array-item"
                data-prop={`${index}`}
              >
                <Split
                  distributionMode="half"
                  minSplitWidth="700"
                  gap="xl"
                  useDefaultEditableBinding={false}
                >
                  <Fragment slot="first">
                    <SimpleText
                      size="md"
                      data-prop={`instruction`}
                    >
                      {step.instruction}
                    </SimpleText>
                  </Fragment>
                  <Fragment slot="second">
                    {(Array.isArray(step.ingredients) && step.ingredients.length > 0) ||
                    step.extraNote ? (
                      <Card
                        style="sticky"
                        backgroundColor="highlight"
                        paddingHorizontal="sm"
                        paddingVertical="sm"
                        useDefaultEditableBinding={false}
                      >
                        <Fragment>
                          {Array.isArray(step.ingredients) && step.ingredients.length > 0 && (
                            <>
                              <Heading
                                level="h3"
                                size="xs"
                                useDefaultEditableBinding={false}
                              >
                                Ingredients
                              </Heading>
                              <ul
                                data-editable="array"
                                data-prop="ingredients"
                              >
                                {step.ingredients.map((ing: any, ingIndex: number) => (
                                  <li
                                    key={ingIndex}
                                    data-editable="array-item"
                                  >
                                    <span
                                      data-editable="text"
                                      data-prop={`quantity`}
                                    >
                                      {ing.quantity}
                                    </span>
                                    <span
                                      data-editable="text"
                                      data-prop={`measurement`}
                                    >
                                      {ing.measurement}
                                    </span>
                                    <span
                                      data-editable="text"
                                      data-prop={`ingredient`}
                                    >
                                      {ing.ingredient}
                                    </span>
                                  </li>
                                ))}
                              </ul>
                            </>
                          )}
                        </Fragment>
                        {step.extraNote && (
                          <p
                            data-editable="text"
                            data-prop="extraNote"
                          >
                            {step.extraNote}
                          </p>
                        )}
                      </Card>
                    ) : null}
                  </Fragment>
                </Split>
              </li>
            ))
        }
      </ol>
      <Card
        style="highlight"
        backgroundColor="base"
        paddingHorizontal="md"
        paddingVertical="md"
        useDefaultEditableBinding={false}
      >
        <SimpleText
          size="md"
          data-prop="extraNote"
        >
          {post.data.extraNote}
        </SimpleText>
      </Card>
    </div>
  </CustomSection>
</Page>

<style is:global>
  .time {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) 0;
  }

  .cooking_mode {
    margin-top: var(--spacing-lg);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);

    input[type="checkbox"] {
      width: 1.25em;
      height: 1.25em;
    }
  }
  .ingredients .pane.first {
    height: 100%;
    display: flex;
    flex-direction: column;

    .card {
      height: 100%;
      margin-top: 0;
    }
  }

  .post-container.custom-section > .outer-content > .content {
    padding-bottom: 0 !important;
  }
</style>
