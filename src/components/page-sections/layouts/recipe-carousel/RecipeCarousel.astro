---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import RecipeCarouselItem from "@layoutComponents/recipe-carousel/RecipeCarouselItem.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

const {
  heading,
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  slides = [],
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["recipe-carousel", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Heading
    level="h1"
    size="2xl"
    alignX="center"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Carousel
    label="Recipe carousel"
    slideWidthPercent={100}
    minSlideWidth={0}
    autoPlay={false}
    autoScroll={false}
    data-children-prop="slides"
  >
    {
      slides.map((slide: any, index: number) => (
        <CarouselSlide
          {...htmlAttributes}
          data-editable="array-item"
          data-id="building-blocks/wrappers/carousel/carousel-slide"
        >
          <div
            class="recipe-carousel-slides"
            aria-label={`Slide ${index + 1} of ${slides.length}`}
            data-editable="array-item"
            data-id="page-sections/layouts/recipe-carousel/recipe-carousel-item"
            data-prop=""
          >
            {slide.recipes.map((card: any, index: number) => (
              <RecipeCarouselItem
                data-editable="array-item"
                data-id="page-sections/layouts/recipe-carousel/recipe-carousel-item"
                {...card}
              />
            ))}
          </div>
        </CarouselSlide>
      ))
    }
  </Carousel>
</CustomSection>

<style>
  @layer page-sections {
    .recipe-carousel-slides {
      display: grid;

      @media screen and (min-width: 640px) {
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: repeat(2, 1fr);
      }
    }
  }
</style>
