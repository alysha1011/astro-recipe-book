---
import Component from "@components/utils/renderBlock.astro";
import { slugifyLabel } from "@components/utils/slugify";
import Image from "@core-elements/image/Image.astro";

const {
  label,
  style,
  contentSections,
  beforeContentSections,
  afterContentSections,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical,
  colorScheme = "inherit",
  backgroundColor,
  backgroundImage,
  link,
  showBeforeAfter = true,
  rounded = false,
  border = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  "data-children-prop-before": childrenDataPropBefore,
  "data-children-prop-after": childrenDataPropAfter,
  ...htmlAttributes
} = Astro.props;

const {
  source = "",
  alt = "",
  positionVertical = "top",
  positionHorizontal = "center",
} = backgroundImage || {};

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const effectiveBeforeProp =
  childrenDataPropBefore ?? (useDefaultEditableBinding ? "beforeContentSections" : null);
const arrayDataAttributesBefore = effectiveBeforeProp
  ? { "data-editable": "array", "data-prop": effectiveBeforeProp }
  : {};

const effectiveAfterProp =
  childrenDataPropAfter ?? (useDefaultEditableBinding ? "afterContentSections" : null);
const arrayDataAttributesAfter = effectiveAfterProp
  ? { "data-editable": "array", "data-prop": effectiveAfterProp }
  : {};

const Tag = link ? "a" : "div";
const hasBeforeSlot = Astro.slots.has("before");
const hasAfterSlot = Astro.slots.has("after");
const usesBeforeContentSections = !hasBeforeSlot && showBeforeAfter && beforeContentSections;
const usesAfterContentSections = !hasAfterSlot && showBeforeAfter && afterContentSections;
---

<div
  class:list={["card", `style-${style}`, className]}
  {...htmlAttributes}
>
  <Tag
    {...link && { href: link }}
    class:list={["card-inner", rounded && "rounded", border && "border"]}
    data-theme={colorScheme && colorScheme !== "inherit" ? colorScheme : undefined}
  >
    <Image
      class:list={["background-image"]}
      source={source}
      alt={alt}
      aspectRatio="square"
      data-prop-src="backgroundImage.source"
      data-prop-alt="backgroundImage.alt"
      positionVertical={positionVertical}
      positionHorizontal={positionHorizontal}
    />
    {
      backgroundColor && (
        <div
          aria-hidden="true"
          class:list={["background", backgroundColor && `bg-${backgroundColor}`]}
        />
      )
    }

    {
      (usesBeforeContentSections || hasBeforeSlot) && (
        <div
          class="before-content"
          {...arrayDataAttributesBefore}
        >
          <slot name="before">
            {beforeContentSections && (
              <Component
                contentSections={beforeContentSections}
                useDefaultEditableBinding={!!effectiveBeforeProp}
              />
            )}
          </slot>
        </div>
      )
    }

    <div class="card-outer-content">
      <div
        class:list={[
          "card-content",
          paddingHorizontal && `pad-x-${paddingHorizontal}`,
          paddingVertical && `pad-y-${paddingVertical}`,
          maxContentWidth && `max-width-${maxContentWidth}`,
        ]}
        {...arrayDataAttributes}
      >
        <slot>
          {
            contentSections && (
              <Component
                contentSections={contentSections}
                useDefaultEditableBinding={!!effectiveChildrenProp}
              />
            )
          }
        </slot>
      </div>
    </div>

    {
      (usesAfterContentSections || hasAfterSlot) && (
        <div
          class="after-content"
          {...arrayDataAttributesAfter}
        >
          <slot name="after">
            {afterContentSections && (
              <Component
                contentSections={afterContentSections}
                useDefaultEditableBinding={!!effectiveAfterProp}
              />
            )}
          </slot>
        </div>
      )
    }
  </Tag>
</div>

<style>
  @layer components {
    .card {
      display: block;
      margin-top: var(--spacing-lg);

      &.style-highlight {
        border: 16px solid rgba(214, 229, 189, 0.4);
      }

      &.style-sticky {
        box-shadow: 1px 10px 20px #00000040;
        border-radius: 2px;
        overflow: hidden;
        position: relative;
      }

      &.style-polaroid {
        position: relative;
        border-radius: 4px;
        background-color: #f8f8f8;
        min-height: 400px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.25);
        background-image:
          repeating-linear-gradient(
            45deg,
            rgba(0, 0, 0, 0.02) 0,
            rgba(0, 0, 0, 0.02) 1px,
            transparent 1px,
            transparent 8px
          ),
          repeating-linear-gradient(
            -45deg,
            rgba(0, 0, 0, 0.02) 0,
            rgba(0, 0, 0, 0.02) 1px,
            transparent 1px,
            transparent 8px
          );
        background-size: 7px 6px;

        &::before,
        &::after {
          content: "";
          position: absolute;
          top: -12px;
          left: -12px;
          width: 50px;
          height: 50px;
          background: #e9e4d8;
          clip-path: polygon(0 0, 100% 0, 0 100%);
          box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
          background-image:
            repeating-linear-gradient(
              45deg,
              rgba(255, 255, 255, 0.2) 0,
              rgba(255, 255, 255, 0.2) 1px,
              transparent 1px,
              transparent 8px
            ),
            repeating-linear-gradient(
              -45deg,
              rgba(0, 0, 0, 0.02) 0,
              rgba(0, 0, 0, 0.02) 1px,
              transparent 1px,
              transparent 8px
            );
          background:
            radial-gradient(circle at 70% 30%, #c4a484, #6e260e 40%),
            radial-gradient(circle at 30% 70%, #c19a6b, #5c4033 45%), #e9e4d8;

          /* texture */
          background-blend-mode: overlay;
        }

        &::after {
          inset: calc(100% - 38px) 0 0 calc(100% - 38px);
          rotate: 180deg;
        }
      }

      > a.card-inner:hover {
        transform: scale(1.05);
      }

      > .card-inner {
        color: inherit;
        display: block;
        height: 100%;
        overflow: hidden;
        position: relative;
        text-decoration: none;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;

        &.rounded {
          border-radius: var(--radius-md);
        }

        &.border {
          border: 1px solid var(--color-border);
        }

        > .card-outer-content {
          height: 100%;
          position: relative;
          z-index: var(--layer-2);

          > .card-content {
            container-type: inline-size;
            height: 100%;
            margin-inline: auto;
            position: relative;
            z-index: var(--layer-1);

            > :global(*:first-child) {
              margin-top: 0 !important;
            }

            > :global(*:last-child) {
              margin-bottom: 0 !important;
            }

            &.pad-x-xs {
              padding-inline: var(--spacing-xs);
            }

            &.pad-x-sm {
              padding-inline: var(--spacing-sm);
            }

            &.pad-x-md {
              padding-inline: var(--spacing-md);
            }

            &.pad-x-lg {
              padding-inline: var(--spacing-lg);
            }

            &.pad-x-xl {
              padding-inline: var(--spacing-xl);
            }

            &.pad-x-2xl {
              padding-inline: var(--spacing-2xl);
            }

            &.pad-y-xs {
              padding-block: var(--spacing-xs);
            }

            &.pad-y-sm {
              padding-block: var(--spacing-sm);
            }

            &.pad-y-md {
              padding-block: var(--spacing-md);
            }

            &.pad-y-lg {
              padding-block: var(--spacing-lg);
            }

            &.pad-y-xl {
              padding-block: var(--spacing-xl);
            }

            &.pad-y-2xl {
              padding-block: var(--spacing-2xl);
            }

            &.max-width-xs {
              max-width: var(--content-width-xs);
            }

            &.max-width-sm {
              max-width: var(--content-width-sm);
            }

            &.max-width-md {
              max-width: var(--content-width-md);
            }

            &.max-width-lg {
              max-width: var(--content-width-lg);
            }

            &.max-width-xl {
              max-width: var(--content-width-xl);
            }

            &.max-width-2xl {
              max-width: var(--content-width-2xl);
            }

            &.max-width-3xl {
              max-width: var(--content-width-3xl);
            }

            @media (width < 640px) {
              &.pad-y-xs {
                padding-block: var(--spacing-xs);
              }

              &.pad-y-sm {
                padding-block: var(--spacing-xs);
              }

              &.pad-y-md {
                padding-block: var(--spacing-sm);
              }

              &.pad-y-lg {
                padding-block: var(--spacing-md);
              }

              &.pad-y-xl {
                padding-block: var(--spacing-md);
              }

              &.pad-y-2xl {
                padding-block: var(--spacing-lg);
              }
            }
          }
        }

        > .before-content,
        > .after-content {
          position: relative;
          z-index: var(--layer-2);

          > :global(*:first-child) {
            margin-top: 0 !important;
          }

          > :global(*:last-child) {
            margin-bottom: 0 !important;
          }
        }

        > .background {
          inset: 0;
          position: absolute;
        }

        > :global(.background-image) {
          position: relative;
          overflow: visible;
          z-index: var(--layer-1);
          width: 90%;
          margin: 5% auto 5% auto;
          filter: contrast(0.95) saturate(0.9);

          &::before {
            content: "";
            box-shadow: inset 0 0 20px rgb(0, 0, 0, 0.25);
            position: absolute;
            width: 100%;
            height: 100%;
          }
          &::after {
            content: "";
            position: absolute;
            left: -6%;
            right: -6%;
            bottom: -5%;
            height: 2px;
            background: radial-gradient(ellipse at top, rgba(0, 0, 0, 0.05), transparent);
          }
        }

        > .bg-base {
          background-color: var(--color-bg);
        }

        > .bg-surface {
          background-color: var(--color-bg-surface);
        }

        > .bg-accent {
          background-color: var(--color-bg-accent);
        }

        > .bg-highlight {
          background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-bg-highlight) 98%, black 2%) 0%,
            var(--color-bg-highlight) 16%,
            color-mix(in srgb, var(--color-bg-highlight) 98%, black 2%) 20%,
            var(--color-bg-highlight) 30%,
            color-mix(in srgb, var(--color-bg-highlight) 90%, white 30%) 100%
          );
        }
      }
    }
  }
</style>
